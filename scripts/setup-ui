#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "$0")/ui-env"
"$MTW_PY" -c 'from mtw.capacity import ensure_space; ensure_space()'
mkdir -p -- "$UI_NATIVE/tools" "$UI_DEPS" "$UI_WORK"
if [[ ! -x "$UI_NODE/bin/node" ]]; then
    archive="$UI_NATIVE/tools/node-v24.22.2-linux-x64.tar.xz"
    curl --fail --location --retry 2 -o "$archive" https://nodejs.org/dist/v24.22.2/node-v24.22.2-linux-x64.tar.xz
    printf '%s  %s\n' '48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75' "$archive" | sha256sum --check
    tar -xJf "$archive" -C "$UI_NATIVE/tools"
fi
cp -- "$UI_REPO/frontend/package.json" "$UI_DEPS/package.json"
if [[ -f "$UI_REPO/frontend/package-lock.json" ]]; then
    cp -- "$UI_REPO/frontend/package-lock.json" "$UI_DEPS/package-lock.json"
    npm ci --prefix "$UI_DEPS" --cache "$UI_NATIVE/npm-cache" --no-audit --no-fund
else
    npm install --prefix "$UI_DEPS" --cache "$UI_NATIVE/npm-cache" --no-audit --no-fund
    cp -- "$UI_DEPS/package-lock.json" "$UI_REPO/frontend/package-lock.json"
fi
if [[ "${1:-}" != --install-only ]]; then
    bash "$UI_REPO/scripts/build-ui"
fi
