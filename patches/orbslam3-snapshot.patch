+ExportSnapshot System::GetMonocularSnapshot(std::size_t max_points, bool include_history)
+{
+    ExportSnapshot snapshot;
+    {
+        unique_lock<mutex> state_lock(mMutexState);
+        snapshot.tracking_state = mTrackingState;
+    }
+    snapshot.timestamp = mpTracker->mCurrentFrame.mTimeStamp;
+    snapshot.points_limit = std::min<std::size_t>(max_points, 100000);
+    snapshot.retained_numeric_records = mpTracker->mExportFrameRecords.size();
+    for (int attempt = 0; attempt < 4; ++attempt)
+    {
+        Map* map = mpAtlas->GetCurrentMap();
+        if (!map) return snapshot;
+        unique_lock<mutex> map_lock(map->mMutexMapUpdate);
+        if (map != mpAtlas->GetCurrentMap() || map->IsBad()) continue;
+        snapshot.map_id = static_cast<std::int64_t>(map->GetId());
+        snapshot.map_change_index = map->GetMapChangeIndex();
+
+        // Only published KFs are borrowed here. Upstream erases their map
+        // membership when culling; it does not physically delete these objects.
+        // Queued (potentially deleted) history references are never dereferenced.
+        std::map<unsigned long, Sophus::SE3f> published;
+        for (KeyFrame* keyframe : map->GetAllKeyFrames())
+        {
+            if (!keyframe || keyframe->isBad() || keyframe->GetMap() != map) continue;
+            const Sophus::SE3f pose = keyframe->GetPose();
+            if (pose.matrix().allFinite()) published.emplace(keyframe->mnId, pose);
+        }
+        snapshot.published_keyframes = published.size();
+        const auto reconstruct = [&published](const Tracking::ExportNumericFrame& record, Eigen::Matrix4f& Twc)
+        {
+            const auto reference = published.find(record.reference_id);
+            if (reference == published.end()) return false;
+            const Sophus::SE3f Tcw = record.Tcr * reference->second;
+            if (!Tcw.matrix().allFinite()) return false;
+            Twc = Tcw.inverse().matrix();
+            return Twc.allFinite();
+        };
+        const auto latest = mpTracker->mExportFrameRecords.find(snapshot.timestamp);
+        if (snapshot.tracking_state == Tracking::OK)
+        {
+            snapshot.pose_unavailable_reason = "numeric_record_unavailable";
+            if (latest != mpTracker->mExportFrameRecords.end())
+            {
+                snapshot.pose_unavailable_reason = "record_map_mismatch";
+                if (latest->second.map_id == snapshot.map_id)
+                {
+                    snapshot.pose_unavailable_reason = "reference_unavailable_or_nonfinite";
+                    snapshot.pose_valid = reconstruct(latest->second, snapshot.Twc);
+                    if (snapshot.pose_valid) snapshot.pose_unavailable_reason.clear();
+                }
+            }
+        }
+        if (include_history)
+        {
+            for (const auto& entry : mpTracker->mExportFrameRecords)
+            {
+                const auto& record = entry.second;
+                if (record.map_id != snapshot.map_id) { ++snapshot.omitted_other_map_poses; continue; }
+                if (published.count(record.reference_id) == 0) { ++snapshot.omitted_reference_poses; continue; }
+                ExportFramePose pose{record.internal_frame_id, record.timestamp, Eigen::Matrix4f::Identity()};
+                if (!reconstruct(record, pose.Twc)) { ++snapshot.omitted_nonfinite_poses; continue; }
+                snapshot.trajectory.push_back(pose);
+            }
+        }
+
+        std::vector<ExportMapPoint> all_points;
+        for (MapPoint* point : map->GetAllMapPoints())
+        {
+            if (!point || point->isBad() || point->GetMap() != map) continue;
+            const Eigen::Vector3f xyz = point->GetWorldPos();
+            if (xyz.allFinite() && !point->isBad()) all_points.push_back({point->mnId, xyz});
+        }
+        std::sort(all_points.begin(), all_points.end(), [](const ExportMapPoint& a, const ExportMapPoint& b) { return a.id < b.id; });
+        snapshot.points_total = all_points.size();
+        snapshot.points.assign(all_points.begin(), all_points.begin() + std::min(snapshot.points_limit, all_points.size()));
+
+        // FNV-1a over explicit numeric bit patterns, plus an exact word signature.
+        // Neither the point output cap nor a map change counter can hide changes.
+        std::uint64_t digest = UINT64_C(14695981039346656037);
+        const auto word = [&](std::uint64_t value)
+        {
+            if (include_history) snapshot.geometry_words.push_back(value);
+            for (int byte = 0; byte < 8; ++byte)
+            {
+                digest ^= (value >> (8 * byte)) & UINT64_C(255);
+                digest *= UINT64_C(1099511628211);
+            }
+        };
+        const auto number = [&](float value)
+        {
+            std::uint32_t bits;
+            std::memcpy(&bits, &value, sizeof(bits));
+            word(bits);
+        };
+        const auto matrix = [&](const Eigen::Matrix4f& value)
+        {
+            for (int row = 0; row < 4; ++row)
+                for (int column = 0; column < 4; ++column) number(value(row, column));
+        };
+        word(static_cast<std::uint64_t>(snapshot.map_id));
+        word(published.size());
+        for (const auto& keyframe : published) { word(keyframe.first); matrix(keyframe.second.matrix()); }
+        word(all_points.size());
+        for (const auto& point : all_points) { word(point.id); number(point.xyz.x()); number(point.xyz.y()); number(point.xyz.z()); }
+        word(snapshot.trajectory.size());
+        for (const auto& pose : snapshot.trajectory)
+        {
+            std::uint64_t timestamp_bits;
+            std::memcpy(&timestamp_bits, &pose.timestamp, sizeof(timestamp_bits));
+            word(pose.internal_frame_id); word(timestamp_bits); matrix(pose.Twc);
+        }
+        snapshot.geometry_digest = digest;
+        return snapshot; // Only values leave the lock; no JSON/I/O occurs here.
+    }
+    snapshot.pose_unavailable_reason = "map_unavailable";
+    return snapshot;
+}
