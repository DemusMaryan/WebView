+ExportWorkerState System::ObserveExportWorkers()
+{
+    ExportWorkerState state;
+    state.mapper_started = mpLocalMapper->ExportRunStarted();
+    state.loop_started = mpLoopCloser->ExportRunStarted();
+    // Atomic telemetry cannot block on a potentially stuck core Finish mutex.
+    state.mapper_finished = state.mapper_started && mpLocalMapper->ExportRunFinished();
+    state.loop_finished = state.loop_started && mpLoopCloser->ExportRunFinished();
+    state.active_gba = mpLoopCloser->ExportActiveGbaCount();
+    state.workers_finished = state.mapper_finished && state.loop_finished && state.active_gba == 0;
+    return state;
+}
+
+ExportWorkerState System::WaitForExportQuiescence(std::uint64_t timeout_ms)
+{
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+    std::mutex wait_mutex;
+    std::condition_variable wait_condition;
+    unique_lock<mutex> wait_lock(wait_mutex);
+    for (;;)
+    {
+        const ExportWorkerState state = ObserveExportWorkers();
+        if (state.workers_finished || !mbShutDown || std::chrono::steady_clock::now() >= deadline)
+            return state;
+        // Only the owner waits, after processing. No worker is paused or reordered.
+        const auto next_poll = std::min(deadline, std::chrono::steady_clock::now() + std::chrono::milliseconds(2));
+        wait_condition.wait_until(wait_lock, next_poll);
+    }
+}
